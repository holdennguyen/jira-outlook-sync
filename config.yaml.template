# Jira Configuration
jira:
  # Jira instance URL (Cloud or Server)
  url: "https://yourcompany.atlassian.net"
  
  # JQL filter to select tickets to sync
  # Examples:
  # - "project = SRE AND status != Done AND plannedStart is not EMPTY"
  # - "assignee = currentUser() AND plannedStart is not EMPTY"
  # - "labels = important AND plannedStart is not EMPTY"
  jql_filter: "project = SRE AND status != Done AND plannedStart is not EMPTY"
  
  # Custom field IDs for planned dates (find these in Jira admin)
  custom_fields:
    planned_start: "customfield_10015"
    planned_end: "customfield_10016"

# Outlook/Microsoft Graph Configuration
outlook:
  # Calendar name to sync to (default: primary calendar)
  calendar_name: "Work Calendar"
  
  # Reminder time in minutes before event (0 to disable)
  reminder_minutes: 15
  
  # Event category/tag for easy filtering
  category: "Jira"
  
  # Show as status (free, tentative, busy, oof, workingElsewhere, unknown)
  show_as: "busy"
  
  # Event title format (available variables: {key}, {summary}, {assignee})
  title_format: "[{key}] {summary}"
  
  # Include Jira link in event location
  include_link_in_location: true

# Sync Configuration
sync:
  # Sync interval in minutes (for continuous mode)
  interval_minutes: 10
  
  # Number of tickets to process per batch
  batch_size: 50
  
  # Timezone for displaying events (default: user's Outlook timezone)
  # Examples: "UTC", "America/Los_Angeles", "Europe/London"
  timezone: "UTC"
  
  # What to do with tickets that only have start date or only end date
  # Options:
  # - start_only: create 1-day event starting at planned start
  # - end_only: create 1-day event ending at planned end
  # - skip: skip tickets without both dates
  date_handling:
    start_only: "1day"  # Create 1-day event
    end_only: "1day_before"  # Create event 1 day before end date
  
  # Delete calendar events when ticket status changes to these values
  delete_on_status:
    - "Done"
    - "Closed"
    - "Cancelled"

# Logging Configuration
logging:
  # Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  level: "INFO"
  
  # Log format
  format: "json"  # Options: json, text
  
  # Log file path (leave empty for stdout only)
  file: ""
  
  # Rotate logs daily
  rotate: true

# State Management
database:
  # SQLite database path for sync state
  path: "sync_state.db"
  
  # Backup frequency in days (0 to disable)
  backup_days: 7

# Error Handling
error_handling:
  # Max retries for transient failures
  max_retries: 3
  
  # Retry backoff multiplier in seconds (exponential: 1s, 4s, 16s)
  retry_backoff: 4
  
  # Continue processing other tickets if one fails
  continue_on_error: true
  
  # Send alert after N consecutive failures (0 to disable)
  alert_after_failures: 3
