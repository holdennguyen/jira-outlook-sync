# Jira Credentials
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Microsoft Graph Credentials
MS_TENANT_ID=your_tenant_id
MS_CLIENT_ID=your_client_id
MS_CLIENT_SECRET=your_client_secret

# Optional: AWS Secrets Manager (if using instead of env vars)
# AWS_SECRETS_ENABLED=false
# AWS_SECRET_NAME=jira-outlook-sync-secrets
# AWS_REGION=us-east-1

# Optional: Azure Key Vault (if using instead of env vars)
# AZURE_KEYVAULT_ENABLED=false
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# Optional: Session token for temporary AWS credentials
# AWS_SESSION_TOKEN=your_session_token

# Optional: Override config file path
# CONFIG_FILE=config.yaml

# Optional: Override sync interval (minutes)
# SYNC_INTERVAL_MINUTES=10

# Optional: Enable debug logging
# DEBUG=false
